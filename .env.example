# ArrDeck live-probe config. Copy to `.env` (which is gitignored) and fill in.
# The API keys are SECRETS — never commit the real .env.

SONARR_URL=http://192.168.1.100:8989
SONARR_API_KEY=your-32-char-sonarr-api-key-here

RADARR_URL=http://192.168.1.100:7878
RADARR_API_KEY=your-32-char-radarr-api-key-here

SAB_URL=http://192.168.1.100:8080
SAB_API_KEY=your-32-char-sabnzbd-api-key-here

PROWLARR_URL=http://192.168.1.100:9696
PROWLARR_API_KEY=your-32-char-prowlarr-api-key-here

# Optional: a second candidate address to exercise the happy-eyeballs race.
# SONARR_URL_REMOTE=http://your-tailscale-or-hostname:8989
# Optional: override the discovery scan target (defaults to SONARR_URL host).
# SCAN_HOST=192.168.1.100
