{
  "name": "arrdeck",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "ArrDeck — self-hosted media stack command center. UI-agnostic engine (src/engine) + React app shell (src/app), cross-platform (Android via Capacitor + web/Docker).",
  "license": "AGPL-3.0-or-later",
  "author": "GrimnirWorks <niamain@gmail.com> (https://grimnirworks.com)",
  "homepage": "https://github.com/OdinKara/arrdeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/OdinKara/arrdeck.git"
  },
  "bugs": {
    "url": "https://github.com/OdinKara/arrdeck/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "tsx scripts/probe-stack.ts",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "server:seed": "tsx server/seed-from-env.ts",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
